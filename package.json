{
  "name": "codegram",
  "scripts": {
    "dev": "bun run --hot src/api/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build": "bun build src/api/index.ts --target=bun --packages=external --outdir=dist"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "hono": "^4.13.7",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "latest",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.0"
  }
}
