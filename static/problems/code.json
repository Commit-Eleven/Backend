  {
    "id": "python-vars-types-code-1",
    "type": "code",
    "title": "변수 만들고 출력하기",
    "description": "name 변수에 이름(문자열), age 변수에 나이(숫자)를 넣고 print 로 두 변수를 출력하세요.",
    "reward": 40,
    "difficulty": 1,
    "language": "python",
    "unitId": "vars-types",
    "content": {
      "starter_code": "# 여기에 작성하세요\n",
      "checks": [
        {
          "pattern": "(^|\\n)\\s*name\\s*=\\s*(\"|')",
          "message": "name 변수에 문자열을 넣어요"
        },
        {
          "pattern": "(^|\\n)\\s*name\\s*=\\s*(\"[^\"\\n]+\"|'[^'\\n]+')",
          "message": "name 에 빈 문자열이 아닌 이름을 넣어요",
          "in": "source"
        },
        {
          "pattern": "(^|\\n)\\s*age\\s*=\\s*\\d+\\s*(\\n|$)",
          "message": "age 변수에 숫자를 넣어요"
        },
        {
          "pattern": "print\\s*\\([^)]*\\bname\\b",
          "message": "print 로 name 을 출력해요"
        },
        {
          "pattern": "print\\s*\\([^)]*\\bage\\b",
          "message": "print 로 age 를 출력해요"
        }
      ]
    }
  },
  {
    "id": "python-conditionals-code-1",
    "type": "code",
    "title": "점수로 합격 판단하기",
    "description": "score 가 60 이상이면 \"합격\", 아니면 \"불합격\" 을 출력하세요.",
    "reward": 40,
    "difficulty": 2,
    "language": "python",
    "unitId": "conditionals",
    "content": {
      "starter_code": "score = 75\n# 여기에 작성하세요\n",
      "checks": [
        {
          "pattern": "\\bif\\s+\\(?\\s*(score\\s*>=\\s*60|60\\s*<=\\s*score)\\s*\\)?\\s*:",
          "message": "if score >= 60: 으로 조건을 써요"
        },
        {
          "pattern": "(^|\\n)\\s*else\\s*:",
          "message": "else: 로 아닌 경우를 처리해요"
        },
        {
          "pattern": "print\\s*\\(\\s*(\"합격\"|'합격')\\s*\\)",
          "message": "print(\"합격\") 을 출력해요",
          "in": "source"
        },
        {
          "pattern": "print\\s*\\(\\s*(\"불합격\"|'불합격')\\s*\\)",
          "message": "print(\"불합격\") 을 출력해요",
          "in": "source"
        }
      ]
    }
  },
